{
  "name": "pagebldr",
  "version": "0.0.0-alpha.0",
  "description": "Embeddable visual page-building engine for React applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@pagebldr/adapters": "workspace:*",
    "@pagebldr/core": "workspace:*",
    "@pagebldr/react": "workspace:*",
    "@pagebldr/runtime": "workspace:*",
    "@pagebldr/server": "workspace:*",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./adapters/memory": {
      "types": "./dist/adapters-memory.d.ts",
      "import": "./dist/adapters-memory.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StartUpMediaUK/pagebldr.git"
  },
  "scripts": {
    "build": "tsup",
    "package:check": "publint && attw --pack --profile esm-only",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
