{
  "format": "pagebldr-clipboard",
  "schemaVersion": 1,
  "rootId": "catalogue-container-119",
  "elements": {
    "catalogue-heading-114": {
      "id": "catalogue-heading-114",
      "type": "heading",
      "elementVersion": 1,
      "name": "Section heading",
      "props": {
        "content": "Stay connected",
        "level": 2
      },
      "children": [],
      "classIds": ["template-heading"],
      "styles": {},
      "locked": false,
      "hidden": false
    },
    "catalogue-rich-text-115": {
      "id": "catalogue-rich-text-115",
      "type": "rich-text",
      "elementVersion": 1,
      "name": "Supporting copy",
      "props": {
        "content": [
          {
            "type": "paragraph",
            "text": "Add your privacy, legal, and contact details here before publishing."
          }
        ]
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {},
      "locked": false,
      "hidden": false
    },
    "catalogue-menu-116": {
      "id": "catalogue-menu-116",
      "type": "menu",
      "elementVersion": 1,
      "name": "Footer links",
      "props": {
        "ariaLabel": "Footer navigation",
        "collapseAt": "mobile",
        "presentation": "dropdown",
        "toggleLabel": "Open footer navigation",
        "panelBackground": "#ffffff",
        "panelPadding": 16,
        "itemGap": 18,
        "itemAlignment": "start",
        "fullscreenVerticalAlignment": "start",
        "itemAppearance": "underline",
        "itemBackground": "#f4f4f5",
        "itemHoverBackground": "#e4e4e7",
        "breakpointPosition": "end",
        "items": [
          {
            "id": "footer-link-1",
            "label": "Privacy policy",
            "destination": {
              "type": "external",
              "url": "https://example.com/privacy-policy",
              "newTab": false
            }
          },
          {
            "id": "footer-link-2",
            "label": "Terms of use",
            "destination": {
              "type": "external",
              "url": "https://example.com/terms-of-use",
              "newTab": false
            }
          },
          {
            "id": "footer-link-3",
            "label": "Contact",
            "destination": {
              "type": "email",
              "address": "hello@example.com"
            }
          }
        ]
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {
        "desktop": {
          "normal": {
            "gap": "18px"
          }
        }
      },
      "locked": false,
      "hidden": false
    },
    "catalogue-social-links-117": {
      "id": "catalogue-social-links-117",
      "type": "social-links",
      "elementVersion": 1,
      "name": "Social links",
      "props": {
        "links": [
          {
            "id": "linkedin",
            "platform": "linkedin",
            "label": "LinkedIn",
            "url": "https://www.linkedin.com"
          },
          {
            "id": "website",
            "platform": "website",
            "label": "Website",
            "url": "https://example.com/start"
          }
        ],
        "newTab": true
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {},
      "locked": false,
      "hidden": false
    },
    "catalogue-copyright-118": {
      "id": "catalogue-copyright-118",
      "type": "copyright",
      "elementVersion": 1,
      "name": "Copyright notice",
      "props": {
        "showSymbol": true,
        "showYear": true,
        "owner": "Your Brand",
        "suffix": "All rights reserved."
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {},
      "locked": false,
      "hidden": false
    },
    "catalogue-container-119": {
      "id": "catalogue-container-119",
      "type": "container",
      "elementVersion": 1,
      "name": "Footer and disclaimer",
      "props": {
        "tag": "footer",
        "layout": "flex"
      },
      "children": [
        "catalogue-heading-114",
        "catalogue-rich-text-115",
        "catalogue-menu-116",
        "catalogue-social-links-117",
        "catalogue-copyright-118"
      ],
      "classIds": ["template-section"],
      "styles": {},
      "locked": false,
      "hidden": false
    }
  },
  "classes": {
    "template-section": {
      "id": "template-section",
      "name": "Template section",
      "styles": {
        "desktop": {
          "normal": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "24px",
            "margin": "0 auto",
            "maxWidth": {
              "type": "variable",
              "variableId": "template-content-width"
            },
            "padding": "88px 32px",
            "width": "100%"
          }
        },
        "tablet": {
          "normal": {
            "padding": "72px 28px"
          }
        },
        "mobile": {
          "normal": {
            "gap": "18px",
            "padding": "56px 20px"
          }
        }
      }
    },
    "template-heading": {
      "id": "template-heading",
      "name": "Template heading",
      "styles": {
        "desktop": {
          "normal": {
            "color": {
              "type": "variable",
              "variableId": "template-ink"
            },
            "fontSize": "52px",
            "fontWeight": 750,
            "letterSpacing": "-0.045em",
            "lineHeight": 1.02,
            "margin": 0
          }
        },
        "tablet": {
          "normal": {
            "fontSize": "44px"
          }
        },
        "mobile": {
          "normal": {
            "fontSize": "36px"
          }
        }
      }
    },
    "template-copy": {
      "id": "template-copy",
      "name": "Template copy",
      "styles": {
        "desktop": {
          "normal": {
            "color": {
              "type": "variable",
              "variableId": "template-muted"
            },
            "fontSize": "18px",
            "lineHeight": 1.65
          }
        },
        "mobile": {
          "normal": {
            "fontSize": "16px"
          }
        }
      }
    },
    "template-button": {
      "id": "template-button",
      "name": "Template button",
      "styles": {
        "desktop": {
          "normal": {
            "backgroundColor": {
              "type": "variable",
              "variableId": "template-brand"
            },
            "borderRadius": "12px",
            "color": "#ffffff",
            "display": "inline-flex",
            "fontWeight": 700,
            "padding": "15px 22px",
            "textDecoration": "none",
            "width": "fit-content"
          },
          "hover": {
            "opacity": 0.9,
            "transform": "translateY(-1px)"
          },
          "focusVisible": {
            "outline": "3px solid rgba(109,93,251,.35)",
            "outlineOffset": "3px"
          }
        },
        "mobile": {
          "normal": {
            "width": "100%"
          }
        }
      }
    },
    "template-card": {
      "id": "template-card",
      "name": "Template card",
      "styles": {
        "desktop": {
          "normal": {
            "backgroundColor": {
              "type": "variable",
              "variableId": "template-surface"
            },
            "borderRadius": "20px",
            "padding": "28px"
          }
        }
      }
    }
  },
  "classOrder": [
    "template-section",
    "template-heading",
    "template-copy",
    "template-button",
    "template-card"
  ],
  "variables": {
    "template-brand": {
      "id": "template-brand",
