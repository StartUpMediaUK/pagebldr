{
  "format": "pagebldr-clipboard",
  "schemaVersion": 1,
  "rootId": "catalogue-container-4",
  "elements": {
    "catalogue-logo-1": {
      "id": "catalogue-logo-1",
      "type": "logo",
      "elementVersion": 1,
      "name": "Site logo",
      "props": {
        "display": "text",
        "text": "Your Brand",
        "source": {
          "type": "external",
          "url": "https://placehold.co/240x80/f4f4f5/171717?text=Your+Brand"
        },
        "alt": "Your Brand",
        "imagePosition": "before",
        "gap": 12,
        "alignment": "center",
        "imageWidth": 120,
        "imageFit": "contain"
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {
        "desktop": {
          "normal": {
            "fontSize": "20px",
            "fontWeight": 800
          }
        }
      },
      "locked": false,
      "hidden": false
    },
    "catalogue-menu-2": {
      "id": "catalogue-menu-2",
      "type": "menu",
      "elementVersion": 1,
      "name": "Navigation links",
      "props": {
        "ariaLabel": "Primary navigation",
        "collapseAt": "mobile",
        "presentation": "dropdown",
        "toggleLabel": "Open navigation",
        "panelBackground": "#ffffff",
        "panelPadding": 24,
        "itemGap": 20,
        "itemAlignment": "start",
        "fullscreenVerticalAlignment": "start",
        "itemAppearance": "underline",
        "itemBackground": "#f4f4f5",
        "itemHoverBackground": "#e4e4e7",
        "breakpointPosition": "end",
        "items": [
          {
            "id": "nav-1",
            "label": "About",
            "destination": {
              "type": "external",
              "url": "https://example.com/about",
              "newTab": false
            }
          },
          {
            "id": "nav-2",
            "label": "Benefits",
            "destination": {
              "type": "external",
              "url": "https://example.com/benefits",
              "newTab": false
            }
          },
          {
            "id": "nav-3",
            "label": "FAQ",
            "destination": {
              "type": "external",
              "url": "https://example.com/faq",
              "newTab": false
            }
          }
        ]
      },
      "children": [],
      "classIds": ["template-copy"],
      "styles": {
        "desktop": {
          "normal": {
            "gap": "20px"
          }
        }
      },
      "locked": false,
      "hidden": false
    },
    "catalogue-button-3": {
      "id": "catalogue-button-3",
      "type": "button",
      "elementVersion": 1,
      "name": "Call to action",
      "props": {
        "label": "Begin",
        "destination": {
          "type": "external",
          "url": "https://example.com/start",
          "newTab": false
        }
      },
      "children": [],
      "classIds": ["template-button"],
      "styles": {},
      "locked": false,
      "hidden": false
    },
    "catalogue-container-4": {
      "id": "catalogue-container-4",
      "type": "container",
      "elementVersion": 1,
      "name": "Simple navigation",
      "props": {
        "tag": "header",
        "layout": "flex"
      },
      "children": [
        "catalogue-logo-1",
        "catalogue-menu-2",
        "catalogue-button-3"
      ],
      "classIds": ["template-section"],
      "styles": {
        "desktop": {
          "normal": {
            "alignItems": "center",
            "display": "grid",
            "gap": "24px",
            "gridTemplateColumns": "1fr auto auto",
            "paddingBottom": "24px",
            "paddingTop": "24px"
          }
        },
        "mobile": {
          "normal": {
            "gridTemplateColumns": "1fr auto auto"
          }
        }
      },
      "locked": false,
      "hidden": false
    }
  },
  "classes": {
    "template-section": {
      "id": "template-section",
      "name": "Template section",
      "styles": {
        "desktop": {
          "normal": {
            "display": "flex",
            "flexDirection": "column",
            "gap": "24px",
            "margin": "0 auto",
            "maxWidth": {
              "type": "variable",
              "variableId": "template-content-width"
            },
            "padding": "88px 32px",
            "width": "100%"
          }
        },
        "tablet": {
          "normal": {
            "padding": "72px 28px"
          }
        },
        "mobile": {
          "normal": {
            "gap": "18px",
            "padding": "56px 20px"
          }
        }
      }
    },
    "template-heading": {
      "id": "template-heading",
      "name": "Template heading",
      "styles": {
        "desktop": {
          "normal": {
            "color": {
              "type": "variable",
              "variableId": "template-ink"
            },
            "fontSize": "52px",
            "fontWeight": 750,
            "letterSpacing": "-0.045em",
            "lineHeight": 1.02,
            "margin": 0
          }
        },
        "tablet": {
          "normal": {
            "fontSize": "44px"
          }
        },
        "mobile": {
          "normal": {
            "fontSize": "36px"
          }
        }
      }
    },
    "template-copy": {
      "id": "template-copy",
      "name": "Template copy",
      "styles": {
        "desktop": {
          "normal": {
            "color": {
              "type": "variable",
              "variableId": "template-muted"
            },
            "fontSize": "18px",
            "lineHeight": 1.65
          }
        },
        "mobile": {
          "normal": {
            "fontSize": "16px"
          }
        }
      }
    },
    "template-button": {
      "id": "template-button",
      "name": "Template button",
      "styles": {
        "desktop": {
          "normal": {
            "backgroundColor": {
              "type": "variable",
              "variableId": "template-brand"
            },
            "borderRadius": "12px",
            "color": "#ffffff",
            "display": "inline-flex",
            "fontWeight": 700,
            "padding": "15px 22px",
            "textDecoration": "none",
            "width": "fit-content"
          },
          "hover": {
            "opacity": 0.9,
            "transform": "translateY(-1px)"
          },
          "focusVisible": {
            "outline": "3px solid rgba(109,93,251,.35)",
            "outlineOffset": "3px"
          }
        },
        "mobile": {
          "normal": {
            "width": "100%"
          }
        }
      }
    },
    "template-card": {
      "id": "template-card",
      "name": "Template card",
      "styles": {
        "desktop": {
          "normal": {
            "backgroundColor": {
              "type": "variable",
              "variableId": "template-surface"
            },
            "borderRadius": "20px",
            "padding": "28px"
          }
        }
      }
    }
  },
  "classOrder": [
    "template-section",
    "template-heading",
    "template-copy",
    "template-button",
    "template-card"
  ],
  "variables": {
    "template-brand": {
      "id": "template-brand",
      "name": "Template brand",
      "kind": "color",
      "value": "#6d5dfb"
    },
    "template-ink": {
      "id": "template-ink",
      "name": "Template ink",
      "kind": "color",
      "value": "#171a2b"
    },
    "template-muted": {
      "id": "template-muted",
      "name": "Template muted text",
      "kind": "color",
      "value": "#667085"
    },
    "template-surface": {
      "id": "template-surface",
      "name": "Template surface",
      "kind": "color",
      "value": "#f5f3ff"
    },
    "template-content-width": {
      "id": "template-content-width",
      "name": "Template content width",
      "kind": "contentWidth",
      "value": "1180px"
    },
    "template-section-space": {
      "id": "template-section-space",
      "name": "Template section spacing",
      "kind": "spacing",
      "value": "88px"
    }
  },
  "variableOrder": [
    "template-brand",
    "template-ink",
    "template-muted",
    "template-surface",
    "template-content-width",
    "template-section-space"
  ]
}
