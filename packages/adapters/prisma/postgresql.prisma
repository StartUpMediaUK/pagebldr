generator client {
  provider = "prisma-client-js"
  output   = "../generated/postgresql"
}

datasource db {
  provider = "postgresql"
  url      = env("PAGEBLDR_POSTGRESQL_URL")
}

model PagebldrDocument {
  references Json @default("[]")
  storageId String   @id
  scopeKey  String
  scope     Json
  key       String
  document  Json
  version   Int
  createdAt DateTime
  updatedAt DateTime

  @@index([scopeKey, key])
}

model PagebldrRevision {
  kind        String @default("save")
  title       String @default("")
  actorId     String?
  storageId   String   @id
  scopeKey    String
  scope       Json
  id          String
  documentKey String
  document    Json
  version     Int
  createdAt   DateTime

  @@index([scopeKey, documentKey, createdAt, version])
}

model PagebldrPublication {
  references Json @default("[]")
  storageId   String   @id
  scopeKey    String
  scope       Json
  documentKey String
  revisionId  String
  publishedAt DateTime

  @@index([scopeKey, documentKey])
}

model PagebldrOperation {
  scopeKey    String @default("")
  storageId   String @id
  scope       Json
  id          String
  documentKey String
  fingerprint String
  response    String
  @@index([scopeKey, documentKey])
}

model PagebldrAudit {
  storageId String @id
  scopeKey String
  scope Json
  documentKey String
  event Json
  sequence Int
  deliveredAt DateTime?

  @@unique([scopeKey, documentKey, sequence])
  @@index([scopeKey, documentKey, deliveredAt])
}
