{
  "name": "pagebldr-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the pagebldr visual page-building engine.",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm parity:fixtures:check && pnpm build && pnpm packages:check && pnpm licenses:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "pnpm licenses list",
    "lint": "eslint .",
    "packages:check": "pnpm --filter pagebldr package:check && node scripts/check-packed-package.mjs",
    "parity:fixtures:check": "node scripts/check-parity-fixtures.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.2",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.10"
  }
}
