{
  "name": "pagebldr-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for the pagebldr visual page-building engine.",
  "license": "MIT",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm packages:check && pnpm licenses:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "pnpm licenses list",
    "lint": "eslint .",
    "packages:check": "pnpm --filter pagebldr package:check && node scripts/check-packed-package.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
